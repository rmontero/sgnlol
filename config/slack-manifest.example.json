{
  "display_information": {
    "name": "Relevance Triage",
    "description": "Routes relevant GitHub and Slack updates"
  },
  "features": {
    "bot_user": {"display_name": "Relevance Triage", "always_online": false}
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "channels:history", "groups:history"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://replace-with-your-host.example/webhooks/slack",
      "bot_events": ["message.channels", "message.groups"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
